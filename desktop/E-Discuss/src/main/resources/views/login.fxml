<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.edudiscuss.controllers.LoginController"
           styleClass="login-root">

    <VBox styleClass="login-card" alignment="CENTER" spacing="0" maxWidth="400" maxHeight="480">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

        <!-- Logo / title -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="💬" style="-fx-font-size: 40;"/>
            <Label text="EduDiscuss" styleClass="login-title"/>
            <Label text="Academic Discussion Platform" styleClass="login-subtitle"/>
        </VBox>

        <Region prefHeight="30"/>

        <!-- Error banner -->
        <Label fx:id="errorLabel" styleClass="error-banner" wrapText="true" maxWidth="320" visible="false"/>

        <Region prefHeight="8"/>

        <!-- Form -->
        <VBox fx:id="formBox" spacing="14">
            <VBox spacing="5">
                <Label text="Email address" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="admin@mak.ac.ug" styleClass="form-input"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="form-input"/>
            </VBox>
        </VBox>

        <Region prefHeight="20"/>

        <Button fx:id="loginButton" text="Sign in" onAction="#login"
                styleClass="btn-primary" maxWidth="Infinity"/>

        <Region prefHeight="16"/>
        <Label fx:id="serverLabel" styleClass="server-label"/>
    </VBox>
</StackPane>
