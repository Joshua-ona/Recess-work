<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.edudiscuss.controllers.LoginController"
      alignment="CENTER"
      spacing="15">

    <Label text="EduDiscuss Login"/>

    <TextField
            fx:id="emailField"
            promptText="Email"/>

    <PasswordField
            fx:id="passwordField"
            promptText="Password"/>

    <Button
            text="Login"
            onAction="#login"/>

</VBox>