<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.edudiscuss.controllers.SidebarController"
      spacing="10"
      prefWidth="250"
      style="-fx-background-color:#1E293B; -fx-padding:20;">

    <Button fx:id="dashboardButton" text="Dashboard" onAction="#handleDashboard"/>
    <Button fx:id="groupsButton" text="Groups" onAction="#handleGroups"/>
    <Button fx:id="discussionsButton" text="Discussions" onAction="#handleDiscussions"/>
    <Button fx:id="quizzesButton" text="Quizzes" onAction="#handleQuizzes"/>
    <Button fx:id="notificationsButton" text="Notifications" onAction="#handleNotifications"/>
    <Button fx:id="messagesButton" text="Messages" onAction="#handleMessages"/>
    <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"/>

</VBox>
