<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.edudiscuss.controllers.QuizAttemptController"
            stylesheets="@../css/style.css">

    <!-- Top Navigation -->
    <VBox styleClass="top-nav" AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button text="← Back" styleClass="secondary-button"
                    onAction="#handleBack"/>
            <Label styleClass="brand-text" fx:id="titleLabel" text="Quiz"/>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Timer -->
            <HBox spacing="10" alignment="CENTER">
                <Label text="⏱️" style="-fx-font-size: 18px;"/>
                <Label fx:id="timerLabel" text="00:00:00"
                      style="-fx-font-weight: 600; -fx-font-size: 16px; -fx-text-fill: #4a90e2;"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Scrollable Main Content -->
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge"
                AnchorPane.topAnchor="70" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox spacing="30" style="-fx-padding: 30 30 30 30;">

            <!-- Progress -->
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="progressLabel" style="-fx-font-weight: 600; -fx-text-fill: #4a90e2;" text="Page 1 of 1"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <ProgressBar fx:id="progressBar" styleClass="web-progress" prefHeight="8"/>
            </VBox>

            <!-- Questions Container -->
            <VBox fx:id="questionsBox" spacing="20" styleClass="card">
                <!-- Questions will be dynamically added here -->
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" styleClass="error-label"
                   text="" visible="false" managed="false"/>

            <!-- Navigation Buttons -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="prevBtn" text="← Previous" styleClass="secondary-button"
                        onAction="#goPrevious"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="nextBtn" text="Save &amp; Next →" styleClass="primary-button"
                        onAction="#goNext"/>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>