<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.edudiscuss.controllers.QuizResultController"
            stylesheets="@../../css/style.css">

    <!-- Top Navigation -->
    <VBox styleClass="top-nav"
          AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button text="← Back"
                    styleClass="secondary-button"
                    onAction="#handleBack"/>
            <Label styleClass="brand-text" text="Quiz Result"/>
        </HBox>
    </VBox>

    <!-- Main Content -->
    <VBox spacing="25"
          alignment="CENTER"
          style="-fx-padding:60 30 30 30;"
          AnchorPane.topAnchor="70"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <VBox styleClass="card" spacing="20" alignment="CENTER"
              style="-fx-padding:40; -fx-max-width:480;">

            <Label fx:id="quizTitleLabel"
                   text="Quiz"
                   style="-fx-font-size:20px; -fx-font-weight:600; -fx-text-fill:#1a2332;"/>

            <Label fx:id="scoreLabel"
                   text="— / —"
                   style="-fx-font-size:42px; -fx-font-weight:700; -fx-text-fill:#4a90e2;"/>

            <Label fx:id="autoSubmittedBadge"
                   text="Auto-submitted (time expired)"
                   visible="false"
                   managed="false"
                   style="-fx-text-fill:#e07b39; -fx-font-weight:600;"/>

            <Button text="Back to Quizzes"
                    styleClass="primary-button"
                    onAction="#handleBack"/>

        </VBox>

    </VBox>

</AnchorPane>