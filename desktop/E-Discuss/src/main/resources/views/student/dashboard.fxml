<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.edudiscuss.controllers.StudentDashboardController"
            styleClass="root">

    <left>
        <fx:include source="../components/sidebar.fxml"/>
    </left>

    <center>

        <VBox spacing="20" styleClass="content">

            <!-- Header -->
            <VBox spacing="5">
                <Label fx:id="greetingLabel"
                       text="Welcome"
                       styleClass="page-title"/>
                <Label text="All caught up — great work!"
                       styleClass="page-subtitle"/>
            </VBox>

            <!-- Statistics -->
            <HBox spacing="20">

                <VBox styleClass="card">
                    <Label text="Posts made"/>
                    <Label fx:id="postsLabel"
                           styleClass="big-number"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Quizzes"/>
                    <Label fx:id="quizLabel"
                           styleClass="big-number"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Groups"/>
                    <Label fx:id="groupsLabel"
                           styleClass="big-number"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Participation"/>
                    <Label fx:id="scoreLabel"
                           styleClass="big-number"/>
                </VBox>

            </HBox>

            <!-- Panels -->
            <HBox spacing="20">

                <VBox styleClass="panel">
                    <Label text="My Groups"/>
                    <ListView fx:id="myGroupsList"
                              prefHeight="250"/>
                </VBox>

                <VBox styleClass="panel">
                    <Label text="Browse Groups"/>
                    <ListView fx:id="browseGroupsList"
                              prefHeight="250"/>
                </VBox>

                <VBox styleClass="panel">
                    <Label text="Create Group"/>

                    <TextField promptText="Group name"/>

                    <Button text="Request Group"
                            styleClass="purple-btn"/>
                </VBox>

            </HBox>

        </VBox>

    </center>

</BorderPane>