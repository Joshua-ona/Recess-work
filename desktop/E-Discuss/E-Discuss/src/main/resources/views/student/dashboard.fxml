<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.edudiscuss.controllers.StudentDashboardController"
            styleClass="root">


    <left>
        <fx:include source="../components/sidebar.fxml"/>
    </left>


    <center>


        <VBox spacing="20"
              styleClass="content">


            <!-- HEADER -->

            <VBox spacing="5">

                <Label fx:id="greetingLabel"
                       text="Welcome"
                       styleClass="page-title"/>


                <Label text="All caught up — great work!"
                       styleClass="page-subtitle"/>

            </VBox>




            <!-- STATISTICS -->

            <HBox spacing="20">


                <VBox styleClass="card">

                    <Label text="Posts made"/>

                    <Label fx:id="postsLabel"
                           styleClass="big-number"/>

                </VBox>



                <VBox styleClass="card">

                    <Label text="Quizzes"/>

                    <Label fx:id="quizLabel"
                           styleClass="big-number"/>

                </VBox>



                <VBox styleClass="card">

                    <Label text="Groups"/>

                    <Label fx:id="groupsLabel"
                           styleClass="big-number"/>

                </VBox>



                <VBox styleClass="card">

                    <Label text="Participation Score"/>

                    <Label fx:id="scoreLabel"
                           styleClass="big-number"/>

                </VBox>


            </HBox>





            <!-- USER GROUP AREA -->

            <HBox spacing="20">



                <!-- MY GROUPS -->

                <VBox styleClass="panel"
                      prefWidth="250">


                    <Label text="My Groups"
                           styleClass="section-title"/>


                    <ListView fx:id="myGroupsList"
                              prefHeight="220"/>


                </VBox>





                <!-- BROWSE GROUPS -->

                <VBox styleClass="panel"
                      prefWidth="250">


                    <Label text="Browse All Groups"
                           styleClass="section-title"/>


                    <ListView fx:id="browseGroupsList"
                              prefHeight="220"/>


                </VBox>





                <!-- CREATE GROUP -->

                <VBox styleClass="panel"
                      prefWidth="250"
                      spacing="10">


                    <Label text="Create / Join Groups"
                           styleClass="section-title"/>


                    <TextField fx:id="groupNameField"
                               promptText="Group name"/>


                    <Button fx:id="requestGroupButton"
                            text="Request Group"
                            onAction="#handleRequestGroup"
                            styleClass="purple-btn"/>

                    <Label fx:id="groupRequestStatusLabel"
                           wrapText="true"
                           style="-fx-font-size:11px;"/>


                </VBox>



            </HBox>







            <!-- AI RECOMMENDATIONS -->

            <VBox spacing="15"
                  styleClass="panel">


                <Label text="Groups You Might Like"
                       styleClass="section-title"/>



                <VBox fx:id="recommendedGroupsBox"
                      spacing="10"/>


            </VBox>



        </VBox>


    </center>


</BorderPane>
