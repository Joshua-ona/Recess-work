<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.edudiscuss.controllers.SidebarController"
      spacing="6"
      prefWidth="250"
      style="-fx-background-color:#1E293B; -fx-padding:20;">

    <Label text="EduDiscuss" styleClass="sidebar-logo"/>
    <Label text="Student portal" styleClass="sidebar-role"/>

    <VBox spacing="6" style="-fx-padding: 16 0 0 0;">
        <Button fx:id="dashboardButton" text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
        <Button fx:id="groupsButton" text="Groups" onAction="#handleGroups" styleClass="sidebar-btn" maxWidth="Infinity"/>
        <Button fx:id="discussionsButton" text="Discussions" onAction="#handleDiscussions" styleClass="sidebar-btn" maxWidth="Infinity"/>
        <Button fx:id="quizzesButton" text="Quizzes" onAction="#handleQuizzes" styleClass="sidebar-btn" maxWidth="Infinity"/>
        <Button fx:id="notificationsButton" text="Notifications" onAction="#handleNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
        <Button fx:id="messagesButton" text="Messages" onAction="#handleMessages" styleClass="sidebar-btn" maxWidth="Infinity"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" styleClass="sidebar-btn-danger" maxWidth="Infinity"/>

</VBox>

